{
  "name": "careflow-hospital-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev": "concurrently -k \"npm:server:dev\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "server:dev": "node --watch server/index.js",
    "db:migrate": "node server/index.js --migrate",
    "db:create-admin": "node server/create-admin.js"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "express": "latest",
    "express-session": "latest",
    "connect-pg-simple": "latest",
    "pg": "latest",
    "bcryptjs": "latest",
    "zod": "latest",
    "helmet": "latest",
    "express-rate-limit": "latest",
    "dotenv": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "concurrently": "latest"
  }
}
